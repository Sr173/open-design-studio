# ai-design 后端配置
# 复制成 .env 并填值

# Provider:anthropic | openai
# openai 包括所有 OpenAI 规范兼容(Together / DeepSeek / Moonshot / OpenRouter / Groq / 自定义)
PROVIDER=openai

# 模型名
MODEL=gpt-5.5

# API key
API_KEY=sk-...

# Base URL(只对 openai 规范有意义;Anthropic 官方留空就行)
BASE_URL=http://cr.killvxk.com:58080/openai/v1

# 后端口(默认 5174,前端 vite proxy 已配)
PORT=5174
