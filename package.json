{
  "name": "open-design-studio",
  "version": "0.6.0",
  "description": "Open-source AI design studio. Multi-variant canvas, inspect & edit in code. Powered by Claude / GPT. 本地优先的 AI 设计工作台。",
  "keywords": [
    "open-design",
    "ai-design",
    "claude",
    "claude-code",
    "anthropic",
    "design-tool",
    "figma-alternative",
    "electron",
    "local-first",
    "multi-variant",
    "design-system",
    "ai-coding"
  ],
  "homepage": "https://github.com/Sr173/open-design-studio",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron/tsconfig.json",
    "electron:build": "node electron/build.mjs",
    "electron:build:watch": "node electron/build.mjs --watch",
    "electron:dev": "concurrently -n vite,esbuild,electron -c magenta,yellow,cyan \"pnpm dev:client\" \"pnpm electron:build:watch\" \"wait-on http://localhost:5173 dist-electron/main.mjs && electron dist-electron/main.mjs\"",
    "electron:start": "electron dist-electron/main.mjs",
    "reprocess-aids": "tsx scripts/reprocess-aids.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@hono/node-server": "^2.0.1",
    "chokidar": "^5.0.0",
    "dexie": "^4.0.10",
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "jszip": "^3.10.1",
    "keytar": "^7.9.0",
    "nanoid": "^5.0.9",
    "node-html-parser": "^7.1.0",
    "openai": "^4.79.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^25.6.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^9.0.10"
  }
}
